# ZeroCoding Configuration

# Provider name from config/default.yaml or ~/.zerocoding/config.yaml
ZEROCODING_PROVIDER=ollama_local

# Ollama
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible APIs
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# Active model override
ZEROCODING_MODEL=deepseek-coder-v2

# Local paths
ZEROCODING_MEMORY_PATH=.zerocoding/memory.db
ZEROCODING_SKILLS_PATH=skills

# UI
ZEROCODING_THEME=purple
ZEROCODING_AUTO_SAVE=true
