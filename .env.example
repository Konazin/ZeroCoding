# ZeroCoding Configuration

# Provider: openai or ollama
ZEROCODING_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_URL=https://api.openai.com/v1

# Ollama Configuration  
OLLAMA_URL=http://localhost:11434

# Model to use
ZEROCODING_MODEL=qwen2.5-coder:7b

# Memory database path
ZEROCODING_MEMORY_PATH=.zerocoding/memory.db

# Skills directory path
ZEROCODING_SKILLS_PATH=skills

# UI Theme: dark, light, auto
ZEROCODING_THEME=dark

# Auto-save memory after each conversation
ZEROCODING_AUTO_SAVE=true
